# Copy this file to ".env" and fill in the values.
PORT=3000

# From Meta (developers.facebook.com > your app > WhatsApp > API Setup)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Any secret word you choose. Paste the same word into Meta when adding the webhook.
WEBHOOK_VERIFY_TOKEN=choose-a-secret-word

# Optional but recommended: App Secret (Meta app > Settings > Basic). Rejects forged webhook calls.
APP_SECRET=

# PIN for the built-in Admin account (change it!)
ADMIN_PIN=1234

# Set to false to start with no demo team, organizations or orders
SEED_DEMO=true

# Time zone used for report schedules (default Asia/Karachi)
TZ=Asia/Karachi

# Optional: Microsoft app (client) ID, only for OneDrive / Excel sheets. You can also type it in the dashboard
# (Order tracking > Microsoft sign-in). MS_TENANT can stay empty ("common").
MS_CLIENT_ID=
MS_TENANT=

# Optional AI keys (or set them in the app: any chat > AI settings)
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
